# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True

# CORS Settings
CORS_ORIGINS=["*"]

# Model Configuration
INTENT_MODEL_NAME=valhalla/distilbart-mnli-12-1
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Groq API Configuration
# Get your FREE API key from: https://console.groq.com (14,400 requests/day)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=llama-3.3-70b-versatile
USE_GROQ=True
GROQ_MAX_TOKENS=2048
GROQ_TEMPERATURE=0.7

# Confidence Thresholds
INTENT_CONFIDENCE_THRESHOLD=0.50
RETRIEVAL_CONFIDENCE_THRESHOLD=0.25

# RAG Settings
CHUNK_SIZE=1500
CHUNK_OVERLAP=300
TOP_K_RETRIEVAL=8

# Vector Database
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=msme_knowledge_base

# Paths
KNOWLEDGE_BASE_DIR=./knowledge_base
MODELS_DIR=./models_cache
